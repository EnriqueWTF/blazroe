@page "/historial"
@rendermode InteractiveServer
@using blazroe.Components.Data
@using Microsoft.EntityFrameworkCore
@inject FacturaContexto Contexto
@inject NavigationManager NavManager
@inject IJSRuntime JS

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f3f4f6;
    }

    .glass-card {
        background: white;
        border: 1px solid rgba(255,255,255,0.5);
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.08);
        border-radius: 16px;
    }

    .btn-create {
        background: linear-gradient(135deg, #111827 0%, #374151 100%);
        color: white;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .vault-panel {
        background-color: #e5e7eb;
        border: 2px dashed #9ca3af;
        border-radius: 15px;
        transition: all 0.3s;
    }

    .vault-open {
        background-color: #fff;
        border: 2px solid #ef4444;
    }
</style>

<div class="container mt-5">
   
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div><h2 class="fw-bold text-dark mb-0">Dashboard de Ventas</h2><p class="text-muted">Resumen de facturas activas</p></div>
        <button class="btn btn-create px-4 py-2 rounded-pill" @onclick="IrACrear"><i class="bi bi-plus-lg me-2"></i> Nueva Factura</button>
    </div>

    @* MÉTRICAS (Solo cuentan lo NO archivado) *@
    <div class="row g-4 mb-4">
        <div class="col-md-4"><div class="glass-card p-4 border-start border-4 border-primary"><p class="text-muted small fw-bold">Ingresos Activos</p><h3 class="fw-bolder m-0">@facturasGuardadas.Sum(f => f.Total).ToString("C")</h3></div></div>
        <div class="col-md-4"><div class="glass-card p-4 border-start border-4 border-success"><p class="text-muted small fw-bold">Facturas Activas</p><h3 class="fw-bolder m-0">@facturasGuardadas.Count</h3></div></div>
        <div class="col-md-4"><div class="glass-card p-4 border-start border-4 border-warning"><p class="text-muted small fw-bold">Promedio</p><h3 class="fw-bolder m-0">@(facturasGuardadas.Any() ? facturasGuardadas.Average(f => f.Total).ToString("C") : "$0.00")</h3></div></div>
    </div>

    @* TABLA PRINCIPAL (Activas) *@
    <div class="glass-card overflow-hidden mb-5">
        <div class="p-4 border-bottom bg-white"><h5 class="fw-bold m-0">Transacciones Recientes</h5></div>
        <div class="table-responsive">
            @if (facturasGuardadas.Any())
            {
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light small text-uppercase"><tr><th class="ps-4">ID</th><th>Cliente</th><th>Fecha</th><th class="text-end">Monto</th><th class="text-center pe-4">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var fac in facturasGuardadas)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@fac.Id.ToString("D4")</td>
                                <td class="fw-bold">@fac.NombreCliente</td>
                                <td class="text-muted">@fac.Fecha.ToShortDateString()</td>
                                <td class="text-end fw-bold text-success">@fac.Total.ToString("C")</td>
                                <td class="text-center pe-4">

                                    @* Boton Archivar *@
                                    <button class="btn btn-sm btn-outline-secondary" title="Archivar (Ocultar)" @onclick="() => ArchivarFactura(fac)">
                                        <i class="bi bi-archive-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {

                <div class="p-5 text-center text-muted">Sin facturas activas.</div>
            }
        </div>
    </div>

    @* --- LA BOVEDA (ZONA SEGURA) --- *@
    <div class="mt-5 mb-5">
        <h6 class="text-uppercase text-muted fw-bold small ls-1 mb-3"><i class="bi bi-shield-lock-fill me-2"></i>Zona Restringida</h6>

        <div class="p-4 @(BovedaAbierta ? "vault-open shadow" : "vault-panel")">

            @if (!BovedaAbierta)
            {
                // ESTADO 1: BLOQUEADO
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-secondary m-0">Archivo Muerto</h5>
                        <p class="small text-muted m-0">Las facturas archivadas están ocultas.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <input type="password" @bind="PasswordInput" class="form-control" placeholder="Contraseña..." style="width: 150px;">
                        <button class="btn btn-secondary" @onclick="IntentarAbrirBoveda">Desbloquear</button>
                    </div>
                </div>
                @if (ErrorPassword)
                {
                    <p class="text-danger small mt-2 fw-bold">Contraseña incorrecta.</p>
                }
            }
            else
            {
                // ESTADO 2: ABIERTO (Muestra las archivadas)
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-danger fw-bold"><i class="bi bi-unlock-fill me-2"></i>Bóveda Abierta</h5>
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarBoveda">Bloquear de nuevo</button>
                </div>

                @if (facturasArchivadas.Any())
                {
                    <table class="table table-sm table-bordered bg-white">
                        <thead class="table-danger"><tr><th>ID</th><th>Cliente</th><th>Total</th><th>Acción</th></tr></thead>
                        <tbody>
                            @foreach (var arch in facturasArchivadas)
                            {
                                <tr>
                                    <td>#@arch.Id</td>
                                    <td>@arch.NombreCliente</td>
                                    <td>@arch.Total.ToString("C")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-success fw-bold" @onclick="() => DesarchivarFactura(arch)">
                                            <i class="bi bi-arrow-up-circle me-1"></i> Recuperar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted fst-italic">No hay documentos en el archivo muerto.</p>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<Factura> facturasGuardadas = new List<Factura>();
    private List<Factura> facturasArchivadas = new List<Factura>(); 

    private bool BovedaAbierta = false;
    private string PasswordInput = "";
    private bool ErrorPassword = false;
    private const string PASSWORD_SECRETA = "1234"; 

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
     
        facturasGuardadas = await Contexto.Facturas
                                          .Include(f => f.Articulos)
                                          .Where(f => !f.Archivada) 
                                          .OrderByDescending(f => f.Id)
                                          .ToListAsync();

       
        if (BovedaAbierta)
        {
            facturasArchivadas = await Contexto.Facturas
                                              .Include(f => f.Articulos)
                                              .Where(f => f.Archivada) 
                                              .ToListAsync();
        }
    }

    
    private async Task ArchivarFactura(Factura f)
    {
        f.Archivada = true;
        await Contexto.SaveChangesAsync();
        await CargarDatos(); 
    }


    private async Task DesarchivarFactura(Factura f)
    {
        f.Archivada = false;
        await Contexto.SaveChangesAsync();
        await CargarDatos(); 
    }

   
    private async Task IntentarAbrirBoveda()
    {
        if (PasswordInput == PASSWORD_SECRETA)
        {
            BovedaAbierta = true;
            ErrorPassword = false;
            PasswordInput = ""; 
            await CargarDatos(); 
        }
        else
        {
            ErrorPassword = true;
        }
    }

    private void CerrarBoveda()
    {
        BovedaAbierta = false;
        facturasArchivadas.Clear(); 
    }

    private void IrACrear() { NavManager.NavigateTo("/Factura"); }
}