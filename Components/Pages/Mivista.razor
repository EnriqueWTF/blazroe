@page "/Factura"
@rendermode InteractiveServer

@using blazroe.Components.Data

<input @bind="facturaActual.NombreCliente" placeholder="Nombre Cliente" />


<input type="date" @bind="facturaActual.Fecha" />

<input @bind="articuloActual.Nombre" placeholder="Nombre Artículo" />


<input type="number" @bind="articuloActual.Precio" placeholder="Precio" />


<button @onclick="AgregarArticulo">Agregar Artículo</button>

<hr>

<h3>Factura Actual</h3>
@foreach (var item in facturaActual.Articulos)
{
    <p>@item.Nombre - @item.Precio.ToString("C")</p>
}

<p><strong>TOTAL: @facturaActual.Total.ToString("C")</strong></p>


<button @onclick="GuardarFactura">Guardar Factura</button>

<hr>

<h3>Facturas Guardadas</h3>
@foreach (var fac in facturasGuardadas)
{
  
        <p>Cliente: @fac.NombreCliente</p>
        <p>Fecha: @fac.Fecha.ToShortDateString()</p>
        <p>Total: @fac.Total.ToString("C")</p>
   
}







@code {

    private List<Factura> facturasGuardadas = new List<Factura>();
    private Factura facturaActual = new();
    private Articulo articuloActual = new();

  

    private void AgregarArticulo()
    {
        if (!string.IsNullOrWhiteSpace(articuloActual.Nombre) && articuloActual.Precio > 0)
        {
            facturaActual.Articulos.Add(articuloActual);
            articuloActual = new Articulo();
        }
    }

    private void GuardarFactura()
    {
        if (!string.IsNullOrWhiteSpace(facturaActual.NombreCliente) && facturaActual.Articulos.Any())
        {
            facturasGuardadas.Add(facturaActual);
            facturaActual = new Factura();
        }
    }
}